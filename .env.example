# Secret for the session cookie (any long random string)
SESSION_SECRET=change-me-to-a-long-random-string
# SoftOne (the only data source)
S1_URL=https://your-host/s1services
S1_APPID=1001
S1_COMPANY=1000
S1_BRANCH=1000
S1_MODULE=0
S1_REFID=1
# 0 = search all customers while CCCISDOCTOR is not yet set (transition only)
S1_DOCTORS_ONLY=1
# SALDOC series used for CRM offers (one document per offer version)
S1_OFFER_SERIES=7015
# SOMEETING series used for Άφιξη/Αναχώρηση (FROMDATE / FINALDATE)
S1_ARRIVAL_SERIES=2001
# SOTASK series used for Εκκρεμότητες
S1_TASK_SERIES=3000
# «Επόμενη ενέργεια» after an Εκκρεμότητα: SOCALL / SOEMAIL / SOMEETING series
S1_CALL_SERIES=1000
S1_EMAIL_SERIES=1003
S1_MEETING_SERIES=2003

# ΑΑΔΕ RgWsPublic2 «Ειδικοί Κωδικοί» for the ΑΦΜ lookup on the doctor form (not TAXISnet codes)
GSIS_USERNAME=
GSIS_PASSWORD=
